class Solution {
public:
    ListNode* removeNodes(ListNode* head) {
        if (!head)
            return NULL;
        ListNode *prev = NULL, *curr = head;
        while (curr) {
            ListNode* nextNode = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextNode;
        }
        ListNode* newHead = NULL;
        int maxVal = INT_MIN;
        while (prev) {
            if (prev->val >= maxVal) {
                ListNode* newNode = new ListNode(prev->val);
                newNode->next = newHead;
                newHead = newNode;
                maxVal = prev->val;
            }
            prev = prev->next;
        }
        return newHead;
    }
};

