class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        ListNode* curr = head;
        int count = 0;
        while (curr != NULL && count < k) {
            curr = curr->next;
            count++;
        }
        if (count == k) {
            ListNode* next = NULL;
            ListNode* prev = NULL;
            curr = head;
            count = 0;
            while (curr != NULL && count < k) {
                next = curr->next;
                curr->next = prev;
                prev = curr;
                curr = next;
                count++;
            }
            head->next = reverseKGroup(curr, k);
            return prev;
        }
        return head;
    }
};

