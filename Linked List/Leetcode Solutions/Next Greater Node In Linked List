class Solution {
public:
    vector<int> nextLargerNodes(ListNode* head) {
        vector<int> v;
        stack<int> st;
        ListNode* curr = head;
        while (curr) {
            v.push_back(curr->val);
            curr = curr->next;
        }
        vector<int> ans(v.size(), 0);
        for (int i = v.size() - 1; i >= 0; --i) {
            while (!st.empty() && st.top() <= v[i]) {
                st.pop();
            }
            if (!st.empty()) {
                ans[i] = st.top();
            }
            st.push(v[i]);
        }
        return ans;
    }
};


