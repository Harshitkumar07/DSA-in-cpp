class Solution {
public:
    int maxDifference(string s) {
        int odd = INT_MIN, even = INT_MAX;
        int freq[26] = {0};
        for (char c : s) {
            freq[c - 'a']++;
        }
        for (int n : freq) {
            if (n == 0) {
                continue;
            }
            if (n % 2 == 0) {
                even = min(even, n);
            } else {
                odd = max(odd, n);
            }
        }
        return odd - even;
    }
};


