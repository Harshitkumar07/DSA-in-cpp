class Solution {
public:
    bool areOccurrencesEqual(string s) {
        unordered_map<char, int> map;
        int ans = -1;
        for (int i = 0; i < s.size(); i++) {
            map[s[i]] += 1;
            ans = max(map[s[i]], ans);
        }
        for (auto c : map) {
            if (c.second != ans) {
                return false;
            }
        }
        return true;
    }
};

