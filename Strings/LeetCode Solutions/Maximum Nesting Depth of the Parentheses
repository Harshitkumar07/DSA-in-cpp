class Solution {
public:
    int maxDepth(string s) {
        int maxDepth = 0, currDepth = 0;
        for (char c : s) {
            if (c == '(') {
                currDepth++;
                maxDepth = max(maxDepth, currDepth);
            } else if (c == ')') {
                currDepth--;
            }
        }
        return maxDepth;
    }
};

