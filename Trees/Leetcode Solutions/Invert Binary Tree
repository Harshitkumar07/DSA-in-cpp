class Solution {
public:
    void solve(TreeNode* root) {
        if (root == nullptr) {
            return;
        }
        if (root != nullptr) {
            swap(root->left, root->right);
        }
        solve(root->left);
        solve(root->right);
    }
    TreeNode* invertTree(TreeNode* root) { 
        solve(root); 
        return root;
    }
};

