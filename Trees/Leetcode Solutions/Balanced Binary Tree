class Solution {
public:
    int check(TreeNode* root) {
        if (!root)
            return 0;
        int left = check(root->left), right = check(root->right);

        if (left == -1 || right == -1 || abs(left - right) > 1) {
            return -1;
        }
        return max(left, right) + 1;
    }
    bool isBalanced(TreeNode* root) { 
        return check(root) != -1; 
    }
};

