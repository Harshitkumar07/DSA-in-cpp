class Solution {
public:
    bool hasPathSum(TreeNode* root, int targetSum) {
        if (root == nullptr) {
            return false;
        }
        if (root->left == nullptr && root->right == nullptr) {
            return targetSum == root->val;
        }
        int ans = targetSum - root->val;
        return hasPathSum(root->left, ans) || hasPathSum(root->right, ans);
    }
};

