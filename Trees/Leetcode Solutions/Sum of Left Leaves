class Solution {
public:
    int solve(TreeNode* node) {
        if (node == nullptr) {
            return 0;
        }
        int sum = 0;
        if (node->left && !node->left->left && !node->left->right) {
            sum += node->left->val;
        }
        sum += solve(node->left);
        sum += solve(node->right);
        return sum;
    }
    int sumOfLeftLeaves(TreeNode* root) { 
        return solve(root); 
    }
};

