class Solution {
public:
    int minimumOperations(vector<int>& nums) {
        unordered_map<int, int> map;
        for (int i = nums.size() - 1; i >= 0; i--) {
            map[nums[i]]++;
            if (map[nums[i]] > 1) {
                return i / 3 + 1;
            }
        }
        return 0;
    }
};

