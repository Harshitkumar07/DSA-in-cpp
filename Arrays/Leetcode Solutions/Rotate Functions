class Solution {
public:
    int maxRotateFunction(vector<int>& nums) {
        long int sum = 0, org = 0;
        int n = nums.size();
        for (int i = 0; i < n; i++) {
            sum += nums[i];
            org += i * nums[i];
        }
        long int Max = org;
        for (int i = n - 1; i >= 0; i--) {
            org += sum - (nums[i] * n);
            Max = max(org, Max);
        }
        return Max;
    }
};

