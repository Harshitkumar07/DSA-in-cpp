class Solution {
public:
    int minimumRecolors(string blocks, int k) {
        int minRecolors = k, currWCount = 0;
        for (int i = 0; i < k; i++) {
            if (blocks[i] == 'W') 
                currWCount++;
        }
        minRecolors = currWCount;
        for (int i = k; i < blocks.size(); i++) {
            if (blocks[i - k] == 'W') 
                currWCount--;
            if (blocks[i] == 'W') 
                currWCount++;
            minRecolors = min(minRecolors, currWCount);
        }
        return minRecolors;
    }
};

