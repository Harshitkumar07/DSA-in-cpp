class Solution {
public:
    vector<int> findClosestElements(vector<int>& arr, int k, int x) {
        int n = arr.size();
        int left = 0, right = n - 1;
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (arr[mid] < x) 
                left = mid + 1;
            else 
                right = mid;
        }
        left = right - 1;
        right = right;
        vector<int> ans;
        while (k-- > 0) {
            if (left < 0) {
                ans.push_back(arr[right++]);
            } else if (right >= n) {
                ans.push_back(arr[left--]);
            } else if (x - arr[left] <= arr[right] - x) {
                ans.push_back(arr[left--]);
            } else {
                ans.push_back(arr[right++]);
            }
        }
        sort(ans.begin(), ans.end());
        return ans;
    }
};

