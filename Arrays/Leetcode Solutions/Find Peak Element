class Solution {
public:
    int findPeakElement(vector<int>& nums) {
        int right = nums.size() - 1, left = 0;
        while (right > left) {
            int mid = (right + left) / 2;
            if (nums[mid] > nums[mid + 1]) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }
        return left;
    }
};

