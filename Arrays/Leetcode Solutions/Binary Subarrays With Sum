class Solution {
public:
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        unordered_map<int, int> map;
        map[0] = 1;
        int currSum = 0, ans = 0;
        for (int num : nums) {
            currSum += num;
            if (map.find(currSum - goal) != map.end()) {
                ans += map[currSum - goal];
            }
            map[currSum]++;
        }
        return ans;
    }
};

