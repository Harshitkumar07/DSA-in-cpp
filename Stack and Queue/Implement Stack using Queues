class MyStack {
public:
    queue<int> q1;
    queue<int> q2;
    MyStack() {}

    void push(int x) {
        // copy elements of q1 in q2
        while (!q1.empty()) {
            q2.push(q1.front());
            q1.pop();
        }
        // push the element
        q1.push(x);
        // copy elemnets of q2 in q1
        while (!q2.empty()) {
            q1.push(q2.front());
            q2.pop();
        }
    }

    int pop() {
        int ans = q1.front();
        q1.pop();
        return ans;
    }

    int top() { return q1.front(); }

    bool empty() { return q1.empty(); }
};

